generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Cliente {
  id          String   @id
  tipo        String
  nome        String
  cpf         String?   @unique
  cnpj        String?   @unique
  razaoSocial String?
  email       String   @unique
  endereco    String
  telefone    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
